# Doxygen configuration for the embedded-http-server API reference.
PROJECT_NAME           = "embedded-http-server"
PROJECT_NUMBER         = 1.0.0
PROJECT_BRIEF          = "Zero-dependency HTTP/1.1 server for embedded Linux devices"
OUTPUT_DIRECTORY       = build-docs
INPUT                  = include/ehs README.md
FILE_PATTERNS          = *.hpp *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
JAVADOC_AUTOBRIEF      = YES
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_AS_ERROR          = NO
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_COLORSTYLE        = DARK
GENERATE_TREEVIEW      = YES
SOURCE_BROWSER         = YES
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = include
IMAGE_PATH             = docs
EXCLUDE_SYMBOLS        = ehs::Server::Connection
